{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "Jwt": {
    "Issuer": "stock-alerts-api",
    "Audience": "stock-alerts-api",
    "ExpirationMinutes": 60
  },
  "StockCheck": {
    "Enabled": true,
    "IntervalSeconds": 60
  },
  "AllowedHosts": "*"
}
