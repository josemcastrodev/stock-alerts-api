# Template for docker compose. Copy to .env (which is git-ignored) and change the values.
# These are placeholders for a local sandbox, not real secrets.

# SQL Server requires 8+ characters mixing upper case, lower case, digits and symbols.
# Avoid ';' because the value is embedded in a connection string.
MSSQL_SA_PASSWORD=Local-sandbox-only-1234

# At least 32 characters.
JWT_KEY=local-sandbox-signing-key-change-me-0123456789

# Admin account created on first start.
ADMIN_EMAIL=admin@stockalerts.local
ADMIN_PASSWORD=Local-sandbox-admin-1234
